# ============================================
# BuyNexa - Environment Variables
# Copy this file to ".env" and fill in real values.
# NEVER commit the real .env file to git.
# ============================================

# --- Database (Postgres recommended: Supabase / Neon / Railway) ---
DATABASE_URL="postgresql://user:password@host:5432/buynexa?schema=public"

# --- Razorpay (https://dashboard.razorpay.com/app/keys) ---
# Public key - safe to expose to the browser (used by Razorpay Checkout.js)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
# Secret key - SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_. Never send to frontend.
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"

# --- Admin Auth ---
# Long random string used to sign admin session JWTs. Generate with: openssl rand -base64 48
ADMIN_JWT_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET"
# Bootstrap admin account (used only by prisma/seed.js to create the first admin user)
ADMIN_SEED_EMAIL="admin@buynexa.com"
ADMIN_SEED_PASSWORD="ChangeThisImmediately123!"

# --- App config ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="BuyNexa"

# --- Delivery defaults (can also be edited later from Admin > Settings) ---
DEFAULT_DELIVERY_CHARGE="49"
FREE_DELIVERY_ABOVE="999"
